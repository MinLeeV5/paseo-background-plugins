    "jsdom": "^26.1.0",
    "playwright": "1.58.2",
    "pngjs": "7.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "zod": "^4.4.3"
  }
}
