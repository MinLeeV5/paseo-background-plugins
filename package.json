{
  "name": "paseo-background-plugins",
  "version": "0.1.3",
  "description": "Choose backgrounds and adjust image and surface opacity in Paseo desktop and web.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/MinLeeV5/paseo-background-plugins.git" },
  "files": ["paseo-plugin.json", "index.client.tsx", "index.server.ts", "client/", "shared/", "assets/", "OVERVIEW.md", "OVERVIEW.zh-CN.md", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
